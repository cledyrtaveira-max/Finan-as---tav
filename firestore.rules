rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: verifica se o token tem custom claim admin:true ──────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Campos absolutamente protegidos (nunca modificáveis pelo usuário) ──
    function camposProtegidosAlterados() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'plano', 'planoBonus', 'planoBonusExpira', 'planoAtualizadoEm',
            'planoExpira', 'bloqueado', 'valorPlano',
            // bônus de indicação: só o Worker (service account) ou admin grava
            'bonusDias', 'bonusDiasAtualizadoEm',
            // C2: "criado" e "email" não podem ser alterados após a criação
            // I12: "codigoIndicacao" e "diasAcesso" também protegidos
            'criado', 'email', 'codigoIndicacao', 'diasAcesso'
          ]);
    }

    // ── Helper: verifica se a conta do usuário está bloqueada ──────
    // I4 FIX: impede gravação pelo console mesmo após signOut forçado
    function contaNaoBloqueada(uid) {
      let snap = get(/databases/$(database)/documents/users/$(uid));
      return !snap.exists || snap.data.bloqueado != true;
    }

    // ── Coleção users ────────────────────────────────────────────────
    match /users/{uid} {
      // Leitura: o próprio usuário OU admin
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isAdmin();

      // Criação: o próprio usuário cria seu perfil, MAS não pode definir
      // campos de plano/assinatura/controle — esses só o Worker escreve.
      // C2 FIX: "criado" deve ser igual ao timestamp do servidor na criação.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
            'plano', 'planoBonus', 'planoBonusExpira', 'planoAtualizadoEm',
            'planoExpira', 'bloqueado', 'valorPlano'
           ]);

      // Atualização: o próprio usuário pode editar campos pessoais,
      // mas NÃO pode alterar campos protegidos (incluindo "criado", "email" — C2, I12).
      // I4 FIX: conta bloqueada não pode atualizar nada.
      // Admin pode atualizar qualquer campo.
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && !camposProtegidosAlterados()
            && contaNaoBloqueada(uid));

      // ── Subcoleções do usuário — admin lê/escreve tudo ──────────────
      // I4 FIX: conta bloqueada não pode escrever subcoleções.
      match /{subcol}/{docId} {
        allow read: if (request.auth != null && request.auth.uid == uid)
                    || isAdmin();
        // auditLog é registro de administração: o usuário não grava (evita log falso)
        allow write: if (request.auth != null && request.auth.uid == uid && contaNaoBloqueada(uid)
                         && subcol != 'auditLog')
                     || isAdmin();
      }
    }

    // ── Lançamentos ──────────────────────────────────────────────────
    match /users/{uid}/lancamentos/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/metas/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/familia/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/dividas/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/config/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }

    // ── Família compartilhada ─────────────────────────────────────────
    // C1 FIX: membros da família (não só o dono) podem ler e escrever
    // subcoleções (lançamentos, config). Isso resolve o bug de criação
    // de família que quebrava a conta do criador.
    // C4 FIX: leitura restrita — só membros da família ou admin.
    // A regra usa "get" (doc único) e nega "list" (coleção inteira).
    // Em list operations, resource não está definido, então separar
    // explicitamente evita vazamento de e-mails de todos os membros.
    match /familias/{codFamilia} {
      // Leitura de documento único: apenas membros da família OU admin
      // (antes: qualquer autenticado podia listar e ver e-mails — C4)
      // Entrar na família: quem tem o código precisa ler o doc (existência e limite de
      // membros). O doc não guarda e-mails (apenas nome curto), então o risco é só saber
      // que o código existe.
      allow get: if request.auth != null;

      // Listagem da coleção: bloqueada para todos (evita scraping de e-mails)
      allow list: if false;

      // Criação: o próprio usuário autenticado cria a família
      allow create: if request.auth != null;

      // Atualização do doc principal:
      // - dono/criador/admin: livre (inclui remover membros);
      // - membro comum: só pode REMOVER A SI MESMO da lista "membros". Como a única
      //   chave que ele pode tocar é "membros", não consegue alterar planoDono,
      //   donoUid, criador nem remover outras pessoas.
      allow update: if request.auth != null
        && (isAdmin()
            || resource.data.donoUid == request.auth.uid
            || resource.data.criador == request.auth.uid
            || (resource.data.membros.hasAny([request.auth.uid])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
                && request.resource.data.membros.toSet()
                   == resource.data.membros.toSet().difference([request.auth.uid].toSet()))
            // Entrar: quem não é membro só pode se ADICIONAR (e nada mais), até 6 membros.
            || (!resource.data.membros.hasAny([request.auth.uid])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
                && request.resource.data.membros.toSet()
                   == resource.data.membros.toSet().union([request.auth.uid].toSet())
                && request.resource.data.membros.size() <= 6));

      // Subcoleções da família (lançamentos, config, metas, etc.)
      // C1 FIX: qualquer membro pode ler/escrever, não apenas o dono
      match /{subcol}/{docId} {
        allow read, write: if request.auth != null
          && (get(/databases/$(database)/documents/familias/$(codFamilia)).data.membros.hasAny([request.auth.uid])
              || isAdmin());
      }

      // Subcoleção membros
      match /membros/{membroUid} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/familias/$(codFamilia)).data.membros.hasAny([request.auth.uid])
              || isAdmin());
        allow write: if request.auth != null
          && (request.auth.uid == membroUid
              || get(/databases/$(database)/documents/familias/$(codFamilia)).data.donoUid == request.auth.uid
              || get(/databases/$(database)/documents/familias/$(codFamilia)).data.criador == request.auth.uid
              || isAdmin());
      }
    }

    // ── Logs de chat/suporte ─────────────────────────────────────────
    match /chatbot_logs/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Indicações (referral) ────────────────────────────────────────
    // I3 FIX: permitir que o app registre indicações lendo por campo indexado
    // A função registrarIndicacaoSeExistir faz .where('codigoIndicacao','==',ref)
    // que requer leitura da coleção users — mas usuários comuns não podem listar
    // users. Solução: mover para coleção própria de indicações com regra dedicada.
    // Por ora, mantemos a regra e corrigimos a função no app para usar /indicacoes.
    match /indicacoes/{docId} {
      // Qualquer autenticado pode criar uma indicação (seu próprio cadastro via ref)
      // Só o próprio indicado cria, como ele mesmo, e nunca se auto-indicando.
      allow create: if request.auth != null
        && request.resource.data.indicadoUid == request.auth.uid
        && request.resource.data.indicadorUid != request.auth.uid
        && request.resource.data.ativo == false;
      // Leitura: indicador ou indicado pode ver as suas, admin vê todas
      allow read: if isAdmin()
        || (request.auth != null
            && (resource.data.indicadorUid == request.auth.uid
                || resource.data.indicadoUid == request.auth.uid));
      // Atualização: apenas admin ou service account
      allow update: if isAdmin();
    }

    // ── Planos pendentes — service account + admin ───────────────────
    // C3 FIX: permitir que o próprio usuário leia APENAS o seu próprio
    // plano pendente (identificado pelo e-mail como chave do documento).
    // Formato da chave: email.replace(/[.@]/g, '_')
    match /planos_pendentes/{emailKey} {
      // Listar a coleção: só admin (antes qualquer autenticado via todas as compras pendentes).
      allow list: if isAdmin();
      // Ler um doc: admin, ou o próprio dono com e-mail VERIFICADO e a chave do doc
      // igual ao e-mail dele normalizado (minúsculas, "." e "@" trocados por "_").
      allow get: if isAdmin()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && request.auth.token.email is string
            && emailKey == request.auth.token.email.lower().replace('[.@]', '_'));
      // Escrita: só admin (o Worker usa service account e ignora as regras).
      allow write: if isAdmin();
    }

    // ── Config do admin (vitalicios, etc.) — admin + service account ─
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Bloquear qualquer outro acesso não mapeado ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
