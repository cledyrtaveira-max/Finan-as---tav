rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: verifica se o token tem custom claim admin:true ──────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Coleção users ────────────────────────────────────────────────
    match /users/{uid} {
      // Leitura: o próprio usuário OU admin com custom claim
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isAdmin();

      // Criação: o próprio usuário cria seu perfil, MAS não pode definir
      // campos de plano/assinatura/controle — esses só o Worker escreve.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
            'plano', 'planoBonus', 'planoBonusExpira', 'planoAtualizadoEm',
            'planoExpira', 'bloqueado', 'valorPlano'
           ]);

      // Atualização: o próprio usuário pode editar campos pessoais,
      // mas NÃO pode alterar campos protegidos.
      // Admin pode atualizar qualquer campo (plano, bloqueado, etc.)
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny([
                  'plano', 'planoBonus', 'planoBonusExpira', 'planoAtualizadoEm',
                  'planoExpira', 'bloqueado', 'valorPlano'
                ]));

      // ── Subcoleções do usuário — admin lê/escreve tudo ──────────────
      match /{subcol}/{docId} {
        allow read, write: if (request.auth != null && request.auth.uid == uid)
                            || isAdmin();
      }
    }

    // ── Lançamentos ──────────────────────────────────────────────────
    // (Coberto pelo wildcard match /{subcol}/{docId} dentro de /users/{uid})
    // Regras explícitas mantidas para clareza e retrocompatibilidade:
    match /users/{uid}/lancamentos/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/metas/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/familia/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/dividas/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }
    match /users/{uid}/config/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || isAdmin();
    }

    // ── Família compartilhada ────────────────────────────────────────
    match /familias/{codFamilia} {
      // Qualquer autenticado pode ler para validar código de convite
      allow read: if request.auth != null;
      // Criação: autenticado; atualização: apenas o dono
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.donoUid == request.auth.uid;
      // Membros da família podem atualizar sub-docs
      match /membros/{membroUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && (request.auth.uid == membroUid
              || get(/databases/$(database)/documents/familias/$(codFamilia)).data.donoUid == request.auth.uid);
      }
    }

    // ── Logs de chat/suporte ─────────────────────────────────────────
    match /chatbot_logs/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin(); // admin pode ler logs
      allow update, delete: if isAdmin();
    }

    // ── Indicações (referral) ────────────────────────────────────────
    match /indicacoes/{docId} {
      allow read: if isAdmin()
        || (request.auth != null
            && (resource.data.indicadorUid == request.auth.uid
                || resource.data.indicadoUid == request.auth.uid));
      allow create: if request.auth != null;
      allow update: if isAdmin(); // só admin ou service account
    }

    // ── Planos pendentes — service account + admin ───────────────────
    match /planos_pendentes/{email} {
      allow read, write: if isAdmin();
    }

    // ── Config do admin (vitalicios, etc.) — admin + service account ─
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Bloquear qualquer outro acesso não mapeado ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
