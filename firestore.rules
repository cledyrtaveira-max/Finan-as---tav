rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Coleção users ────────────────────────────────────────────────
    match /users/{uid} {
      // Leitura: apenas o próprio usuário
      allow read: if request.auth != null && request.auth.uid == uid;

      // Criação: o próprio usuário pode criar seu doc de perfil
      allow create: if request.auth != null && request.auth.uid == uid;

      // Atualização: o próprio usuário pode editar, MAS não pode alterar
      // os campos de plano/assinatura — esses só o Cloudflare Worker (service account) escreve.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plano', 'planoBonus', 'planoBonusExpira', 'planoAtualizadoEm']);
    }

    // ── Lançamentos, metas, família ──────────────────────────────────
    match /users/{uid}/lancamentos/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/metas/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/familia/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Família compartilhada ────────────────────────────────────────
    match /familias/{codFamilia} {
      // Qualquer usuário autenticado pode ler para validar código de convite
      allow read: if request.auth != null;
      // Só o dono (uid == codFamilia ou campo donoUid) pode criar/atualizar
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.donoUid == request.auth.uid
            || !resource.data.keys().hasAny(['donoUid']));
    }

    // ── Indicações (referral) ────────────────────────────────────────
    match /indicacoes/{docId} {
      allow read: if request.auth != null
        && (resource.data.indicadorUid == request.auth.uid
            || resource.data.indicadoUid == request.auth.uid);
      allow create: if request.auth != null;
      // Atualização só pelo sistema (service account) — não pelo cliente
      allow update: if false;
    }

    // ── Planos pendentes (compra antes de criar conta) ───────────────
    // Escrita só pelo Cloudflare Worker (service account), leitura proibida ao cliente
    match /planos_pendentes/{email} {
      allow read, write: if false;
    }

    // ── Bloquear qualquer outro acesso não mapeado ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
