# M14 FIX: Cloudflare Pages — cache headers
# Referência: https://developers.cloudflare.com/pages/configuration/headers/

# ── Shell do app — revalidação obrigatória ──────────────────────────
# finapp.html é o "shell" da PWA. O Service Worker faz network-first,
# mas o browser também precisa revalidar para detectar atualizações.
/finapp.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# ── Service Worker — nunca deve ser cacheado pelo browser ───────────
# Cache curto: evita que browsers guardem o SW por muito tempo.
/sw.js
  Cache-Control: no-store, max-age=0
  X-Content-Type-Options: nosniff

# ── Admin — acesso restrito, sem cache ──────────────────────────────
/admin.html
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# ── Manifest PWA — cache moderado (muda raramente) ──────────────────
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

# ── Ícones e imagens — cache longo (hash no filename se precisar bust) ──
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# ── Assets estáticos (favicon, robots, etc.) ────────────────────────
/favicon.ico
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=3600

# ── Scripts e estilos — cache moderado ──────────────────────────────
# Só se houver arquivos .js/.css separados no futuro
/*.js
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/*.css
  Cache-Control: public, max-age=3600

# ── Segurança global (aplica a todas as rotas) ─────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
